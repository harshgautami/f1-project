# API base URL for the backend.
#
# In development you normally DON'T need to set this: requests to "/api" are
# proxied to http://localhost:5000 by Vite (see vite.config.js), so the app
# and API share one origin.
#
# In production, point this at your deployed backend:
# VITE_API_URL=https://YOUR-BACKEND-DOMAIN.vercel.app/api
